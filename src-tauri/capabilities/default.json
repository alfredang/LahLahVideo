{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the LahLah Video window needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$APPDATA/**" }, { "path": "$VIDEO/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DESKTOP/**" }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/ffmpeg", "sidecar": true, "args": true }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/ffmpeg", "sidecar": true, "args": true }]
    },
    "shell:allow-kill",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "deep-link:default"
  ]
}
