{
  "name": "lahlah-video",
  "productName": "LahLah Video",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "LahLah Video: a simple CapCut-style desktop video editor for Mac and Windows, built for the Claude to Higgsfield to TikTok/YouTube workflow.",
  "author": "Dr Alfred Ang, Tertiary Infotech Academy",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "tauri": "tauri",
    "desktop": "node scripts/fetch-ffmpeg.mjs && tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-deep-link": "~2.6.3",
