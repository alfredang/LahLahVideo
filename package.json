    "@tauri-apps/plugin-http": "~2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
